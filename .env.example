# Copy to .env and fill in. Never commit .env.

# SSH URL of your private data repository (created from data-template/)
BRIEFINGS_REPO_URL=git@github.com:your-user/briefings-data.git

# Host paths: where the checkout lives, and the deploy key with write access to the data repo
BRIEFINGS_HOST_DATA_DIR=/mnt/ssd/briefings
BRIEFINGS_DEPLOY_KEY=./deploy_key

# Host port (127.0.0.1 only); tailscale serve points at it. Pick one no other service uses
APP_PORT=8020

# Must match the time of the scheduled dispatcher run
BRIEFINGS_TZ=Europe/Madrid
BRIEFINGS_DISPATCH_TIME=06:45
BRIEFINGS_SYNC_MINUTES=30

# Author of commits made from the web app
BRIEFINGS_GIT_NAME=briefings-pi
BRIEFINGS_GIT_EMAIL=briefings-pi@localhost

# Theme file in src/briefings/static/themes/ (without .css)
BRIEFINGS_THEME=wire
