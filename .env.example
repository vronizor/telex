# Copy to .env and fill in. Never commit .env.

# SSH URL of your private data repository (created from data-template/)
TELEX_REPO_URL=git@github.com:your-user/telex-data.git

# Host paths: where the checkout lives, and the deploy key with write access to the data repo
TELEX_HOST_DATA_DIR=/mnt/ssd/telex
TELEX_DEPLOY_KEY=./deploy_key

# Host port (127.0.0.1 only); tailscale serve points at it. Pick one no other service uses
APP_PORT=8020

# Must match the time of the scheduled dispatcher run
TELEX_TZ=Europe/Madrid
TELEX_DISPATCH_TIME=06:45
TELEX_SYNC_MINUTES=30

# Weekly e-reader edition, served as OPDS at <BASE_URL>/opds/
TELEX_EDITION_DAY=sat
TELEX_EDITION_TIME=08:00
# The address your e-reader uses (the Tailscale service name); OPDS links must be absolute
TELEX_BASE_URL=https://telex.your-tailnet.ts.net

# Author of commits made from the web app
TELEX_GIT_NAME=telex-pi
TELEX_GIT_EMAIL=telex-pi@localhost

# Theme file in src/telex/static/themes/ (without .css)
TELEX_THEME=wire

# Telex Radio (tts service). All optional.
# TELEX_RADIO_VOICE=af_heart
# TELEX_RADIO_SPEED=1.0
# TELEX_RADIO_THREADS=4
# TELEX_RADIO_KEEP_DAYS=14
